{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mywether",
  "version": "0.1.0",
  "identifier": "com.example.mywether",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "天气 · 日历 · 新闻",
        "width": 320,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "transparent": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "center": false,
        "x": 40,
        "y": 40,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {}
}
